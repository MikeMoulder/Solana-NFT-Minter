# Server Configuration
PORT=3001

# Solana Network (devnet, testnet, mainnet-beta)
NETWORK=devnet

# Optional: Custom RPC URL (leave empty to use default)
# RPC_URL=https://api.devnet.solana.com

# Vercel / Production: backend wallet private key as a JSON array string
# Run this locally to get the value:  node -e "const fs=require('fs'); console.log(fs.readFileSync('.keypair.json','utf-8'))"
# Then paste the output as the value of this variable in the Vercel dashboard.
WALLET_SECRET_KEY=
